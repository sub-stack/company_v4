---
import { Facebook, Instagram, MessageCircle, MapPin } from 'lucide-astro';
import { withBase } from '../utils/withBase';
import { Image } from 'astro:assets';
import logo from '../assets/img/logo.jpg';
import {
	BUSINESS_ADDRESS,
	FACEBOOK_URL,
	GBP_URL,
	INSTAGRAM_URL,
	THREADS_URL,
	LEGAL_NAME,
	PHONE_DIGITS,
	PHONE_DISPLAY,
} from '../utils/seo';

const whatsappHref =
	'https://api.whatsapp.com/send/?phone=85252232817&text=%E6%83%B3%E6%9F%A5%E8%A9%A2%E3%80%8C%E7%B7%9A%E4%B8%8A%E5%BB%A3%E5%91%8A%E3%80%8D%E6%9C%8D%E5%8B%99&type=phone_number&app_absent=0';

const footerLinks = [
	{
		title: '服務項目',
		links: [
			{ name: 'Meta 廣告投放', href: '/services/meta-ads' },
		]
	},
	{
		title: '關於我們',
		links: [
			{ name: '品牌使命', href: '/about/mission' },
			{ name: '合作流程', href: '/about/process' },
			{ name: 'Blog', href: '/insights/blog' },
			{ name: '常見問題', href: '/faq' },
		]
	},
];
---

<footer class="bg-charcoal text-off-white pt-20 pb-10 border-t-4 border-black">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
			<!-- Brand Column -->
			<div class="space-y-6">
				<a href={withBase('/')} class="flex items-center space-x-3 group">
			     <Image 
				    src={logo}
				    width={120}
				    height={120}
				    class="w-[60px] h-[60px] object-cover group-hover:scale-125 transition-transform duration-600" 
				    alt="2xWin Logo" 
				 />
			    </a>
				<p class="text-off-white/60 text-sm leading-relaxed max-w-xs">
					幫中小企擺脫黑箱 Agency，用透明 Meta 廣告穩陣放大生意。唔靠花巧術語，唔靠死約留客。
				</p>
				<div class="flex space-x-4">
					<a href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-white/10 border border-white/20 flex items-center justify-center hover:bg-hot-pink transition-colors" aria-label="Facebook">
						<Facebook size={20} />
					</a>
					<a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-white/10 border border-white/20 flex items-center justify-center hover:bg-hot-pink transition-colors" aria-label="Instagram">
						<Instagram size={20} />
					</a>
					<a href={THREADS_URL} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-white/10 border border-white/20 flex items-center justify-center hover:bg-hot-pink transition-colors" aria-label="Threads">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M18.263 11.097c-.03-3.486-1.92-5.586-5.111-5.586-2.13 0-3.922.963-4.863 2.499l2.062 1.438c.535-.843 1.272-1.543 2.628-1.543 1.528 0 2.318.85 2.544 2.431a15 15 0 0 0-2.236-.173c-4.125 0-6.068 1.867-6.068 4.336s1.943 3.99 4.804 3.99c3.139 0 5.013-2.115 5.781-4.735.798.361 1.348 1.204 1.348 2.47 0 3.387-3.907 5.232-7.22 5.232-4.885 0-8.077-3.207-8.077-8.424 0-6.392 4.223-10.487 9.9-10.487 3.808 0 5.69 1.671 6.97 3.914l2.108-1.475C21.44 2.078 18.331 0 13.663 0 6.227 0 1.168 5.277 1.168 12.934c0 7 4.953 11.066 10.856 11.066 4.878 0 9.809-2.846 9.809-7.716 0-2.545-1.46-4.231-3.569-5.187m-6.33 4.855c-1.077 0-2.026-.512-2.026-1.453 0-1.483 1.822-1.934 3.606-1.934.678 0 1.34.045 1.927.173-.422 1.927-1.671 3.215-3.508 3.214Z" />
						</svg>
					</a>
				</div>
			</div>

			<!-- Links Columns -->
			{footerLinks.map(group => (
				<div>
					<h4 class="font-display font-bold text-lg mb-6 text-aqua-mint">{group.title}</h4>
					<ul class="space-y-4">
						{group.links.map(link => (
							<li>
								<a href={withBase(link.href)} class="text-off-white/70 hover:text-white transition-colors text-sm">
									{link.name}
								</a>
							</li>
						))}
					</ul>
				</div>
			))}

			<div>
				<h4 class="font-display font-bold text-lg mb-6 text-aqua-mint">聯絡資訊</h4>
				<address class="not-italic space-y-4 text-sm text-off-white/70">
					<p class="text-off-white font-medium leading-relaxed">{LEGAL_NAME}</p>
					<p class="flex items-start gap-2 leading-relaxed">
						<MapPin size={16} class="mt-0.5 shrink-0 text-aqua-mint" />
						<span>{BUSINESS_ADDRESS}</span>
					</p>
					<p class="flex items-start gap-2">
						<MessageCircle size={16} class="mt-0.5 shrink-0 text-aqua-mint" />
						<a href={`tel:+${PHONE_DIGITS}`} class="hover:text-white transition-colors">{PHONE_DISPLAY}</a>
					</p>
					<p>
						<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">WhatsApp 查詢</a>
					</p>
					<p>
						<a href={GBP_URL} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Google Business Profile</a>
					</p>
				</address>
			</div>
		</div>

		
	</div>
</footer>
