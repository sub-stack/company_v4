---
interface Props {
	content: string;
}

const { content } = Astro.props;
---

<div class="aeo-summary reveal AEO重點摘要">
	<div class="flex items-start space-x-4">
		
		<div class="space-y-2">
			<p class="text-brand-charcoal text-base leading-[1.6] font-medium">
				{content}
			</p>
		</div>
	</div>
</div>
