---
import { MessageCircle, Whatsapp } from 'lucide-astro';
import {Image} from 'astro:assets';
import whatsapp from '../assets/img/whatsapp.png';
---

<a 
	id="whatsapp-btn"
	href="https://api.whatsapp.com/send/?phone=85252232817&text=%E6%83%B3%E6%9F%A5%E8%A9%A2%E3%80%8C%E7%B7%9A%E4%B8%8A%E5%BB%A3%E5%91%8A%E3%80%8D%E6%9C%8D%E5%8B%99+%28%E6%9F%A5%E8%A9%A2%E7%B7%A8%E8%99%9F%3A+%23225361%29&type=phone_number&app_absent=0" 
	target="_blank" 
	class="fixed bottom-8 right-8 z-50 neo-brutalism-button bg-aqua-mint flex items-center space-x-3 animate-float transition-opacity duration-300"
>
	<div class="w-10 h-10 bg-white border-2 border-black flex items-center justify-center rounded-full shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
		<Image src={whatsapp} alt="WhatsApp Logo" />
	</div>
	<span class="font-display font-black text-lg tracking-tight">免費廣告診斷</span>
</a>
