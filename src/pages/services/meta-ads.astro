---
import Layout from '../../layouts/Layout.astro';
import AEOBlock from '../../components/AEOBlock.astro';
import NeoCard from '../../components/NeoCard.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import { Image } from 'astro:assets';
import whatsapp from '../../assets/img/whatsapp.png';
import metaVerified from '../../assets/img/meta-verified.png';
import metaPartner from '../../assets/img/meta-partner.png';
import { Target, ShieldCheck, Zap, BarChart3, MessageCircle, ArrowRight, Star, Quote, X, Plus } from 'lucide-astro';

const caseStudyImageModules = import.meta.glob('../../assets/img/case-studies/cases-*.jpg', { eager: true });
const caseStudyImages = Object.values(caseStudyImageModules)
	.map((img: any) => img.default)
	.sort((a, b) => a.src.localeCompare(b.src));
const getCaseStudyImage = (index: number) => caseStudyImages[index]?.src ?? caseStudyImages[0]?.src ?? '';

const metaAdsFaqs = [
	{
		question: "之前試過俾 Agency「水」過一頸血，點信你哋？",
		answer: "我哋非常明白被行家燒錢嘅痛，所以我哋嘅定位係行業「揭秘者」，專門踢爆同行 Agency 不良手段 。我哋用過往戰績同商業智慧幫你，唔再做羊牯，比個機會大家由頭黎過。"
	},
	{
		question: "你哋敢唔敢「包單」/ ROAS 肯定有幾多？",
		answer: "行內揭秘： 邊個同你講「保證包單」，佢一定係「水」緊你。生意無必賺，但我敢對天發誓，我哋會用最真實嘅數據操作。如果你的產品本身有問題，神仙都難救。我哋會直接畀商業顧問意見，話你知問題喺邊，而唔係繼續燒你錢。"
	},
	{
		question: "係咪又要簽死一年約？有無得走盞？",
		answer: "絕對唔鎖死你，我哋實行按月收費模式 (No lock-in contracts)，你可以隨時停。因為我哋有信心靠真實業績留客，而唔係靠死約綁住你。",
	},
	{
		question: "我個網未搞好/生意麻麻，可唔可以落住廣告救命先？",
		answer: "呢個階段，絕對唔建議搵外判！生意模式未搞掂想靠廣告救命係死路一條。如果你唔太知自己是否合適，歡迎Send 你個Page/網頁嚟，我哋幫你做個 Body Check 先。",
	},
	{
		question: "我做 Dropshipping / 炒賣 / 賭網 / 煙想博一博，接唔接？",
		answer: "唔好意思，我哋唔做想「空手套白狼」嘅客 。有長遠願景嘅生意先有合作空間。如果你想搵快錢，請繞道; 如果你想踏實做生意，即刻入黎傾 。",
	},
	
];

const caseStudies = [
	{
		title: "醫美行業：2個月大幅提升",
		description: "透過精準受眾定位與素材優化，將原本無人問津的線上諮詢轉化為每日穩定客源。ROAS 提升 400%，每日穩定獲取 10+ 高意向查詢。",
		image: getCaseStudyImage(0),
		tags: ["Meta Ads", "受眾定位", "素材優化"]
	},
	{
		title: "零售業：數據驅動優化",
		description: "打破傳統廣告盲點，利用數據分析找出高價值產品，ROAS 提升 300%。成功將廣告成本降低 40%，同時保持業績穩定增長。",
		image: getCaseStudyImage(2),
		tags: ["Meta Ads", "數據分析", "查詢成本優化"]
	},
	{
		title: "教育中心：系統化獲客",
		description: "建立自動化獲客系統，將廣告流量引導至高轉化 Landing Page。成功將每位學生獲取成本降低 50%，報名人數提升 150%。",
		image: getCaseStudyImage(1),
		tags: [, "Meta Ads", "獲客系統"]
	},
	{
		title: "奢侈品回收店: 查詢成本平一倍",
		description: "針對店鋪周邊區域進行精準投放，並優化預約流程。成功將到店率提升 80%，並建立起穩定的新客來源。",
		image: getCaseStudyImage(3),
		tags: [, "預約優化", "Meta Ads"]
	}
];

const processSteps = [
	{
		title: "1. 商業診斷",
		description: "先分析你嘅服務/產品競爭力，而唔係一嚟就叫你落廣告。",
		icon: Target
	},
	{
		title: "2. 事前帳戶檢查",
		description: "確保帳號及專頁各項設置完善，以建立穩健嘅投放基礎。",
		icon: ShieldCheck
	},
	{
		title: "3. 素材策略",
		description: "根據受眾消費需求為原則，為你挑選較易達到高成效嘅廣告素材，而唔係單憑靠觀感選材。",
		icon: Zap
	},
	{
		title: "4. 數據優化",
		description: "隔日監控成效，根據數據進行 A/B Testing，將 Budget 集中喺最有效嘅地方。",
		icon: BarChart3
	}
];
---

<Layout title="Meta 廣告投放服務 - 透明、穩陣、講真話">
	<!-- Hero -->
	<section class="pt-32 pb-20 bg-electric-yellow/10 border-b-4 border-black">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="max-w-4xl">
				<h1 class="font-display font-black text-4xl md:text-6xl lg:text-7xl leading-[1.1] mb-8 reveal">
					Meta 廣告投放：<br />
					<span class="bg-hot-pink text-white px-2">唔再係黑箱作業</span>
				</h1>
				<p class="text-xl md:text-2xl text-charcoal/80 mb-12 leading-relaxed reveal">
					我哋幫你建立一個透明、可控、且持續獲利嘅廣告系統。由商業分析到數據優化，每一步都同你講人話。
				</p>
				<div class="flex flex-col sm:flex-row gap-6 reveal">
					<a href="https://api.whatsapp.com/send/?phone=85252232817&text=%E6%83%B3%E6%9F%A5%E8%A9%A2%E3%80%8C%E7%B7%9A%E4%B8%8A%E5%BB%A3%E5%91%8A%E3%80%8D%E6%9C%8D%E5%8B%99+%28%E6%9F%A5%E8%A9%A2%E7%B7%A8%E8%99%9F%3A+%23225361%29&type=phone_number&app_absent=0" target="_blank" class="neo-brutalism-button bg-charcoal text-white text-xl py-5 px-10 flex items-center justify-center space-x-3">
						<MessageCircle size={24} />
						<span>立即開始免費診斷</span>
					</a>
					 <!-- Meta Partner Badges -->
				    <div class="flex flex-wrap items-center gap-4 md:gap-6 reveal">
					<Image src={metaPartner} alt="Meta Verified" class="h-12 md:h-14 w-auto object-contain rounded-md" />
					<Image src={metaVerified} alt="Meta Business Partner" class="h-12 md:h-14 w-auto object-contain rounded-md" />
				    </div>
				</div>
				
			</div>
		</div>
	</section>

	<!-- AEO Section -->
	<section class="py-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="max-w-3xl mb-16">
				<h2 class="font-display font-black text-3xl md:text-5xl mb-6 reveal">
					點解 2xWin 嘅 Meta 廣告投放唔同？
				</h2>
				<AEOBlock content="2xWin 的 Meta 廣告服務核心在於「透明度」與「商業邏輯」。我們不使用花巧術語，而是直接在客戶擁有/我們的帳戶中操作，確保數據 100% 可見。我們結合產品力分析與高轉化素材策略，幫助中小企在不綁約的前提下，實現穩定的業績增長。" />
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				{processSteps.map(step => (
					<NeoCard title={step.title} description={step.description} icon={step.icon} />
				))}
			</div>
		</div>
	</section>

	<!-- Comparison Section -->
	<section class="py-24 bg-charcoal text-white border-y-4 border-black">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="font-display font-black text-3xl md:text-5xl text-center mb-20 reveal">
				2xWin vs. 傳統 Agency
			</h2>
			
			<div class="grid grid-cols-1 md:grid-cols-2 gap-12">
				<div class="neo-brutalism-card p-10 bg-white/5 border-white/20 reveal">
					<h3 class="font-display font-black text-2xl mb-8 text-hot-pink">傳統 Agency</h3>
					<ul class="text-off-white space-y-6">
						<li class="flex items-start space-x-4">
							<div class="w-6 h-6 bg-red-500/20 border border-red-500 flex items-center justify-center flex-shrink-0 mt-1">
								<X size={14} class="text-red-500" />
							</div>
							<p class="text-off-white/90 text-base leading-[1.6]">拒絕用你帳戶直接操作，怕你睇真實數據，怕你知setting，唔敢透明</p>
						</li>
						<li class="flex items-start space-x-4">
							<div class="w-6 h-6 bg-red-500/20 border border-red-500 flex items-center justify-center flex-shrink-0 mt-1">
								<X size={14} class="text-red-500" />
							</div>
							<p class="text-off-white/90 text-base leading-[1.6]">簽死約，做得差都無得走</p>
						</li>
						<li class="flex items-start space-x-4">
							<div class="w-6 h-6 bg-red-500/20 border border-red-500 flex items-center justify-center flex-shrink-0 mt-1">
								<X size={14} class="text-red-500" />
							</div>
							<p class="text-off-white/90 text-base leading-[1.6]">放養式落廣告，唔做監控，唔做優化</p>
						</li>
						<li class="flex items-start space-x-4">
							<div class="w-6 h-6 bg-red-500/20 border border-red-500 flex items-center justify-center flex-shrink-0 mt-1">
								<X size={14} class="text-red-500" />
							</div>
							<p class="text-off-white/90 text-base leading-[1.6]">抽佣金收費，你落得多，佢落袋多，無論成效好定壞，都經常搵籍口叫你加預算</p>
						</li>
						<li class="flex items-start space-x-4">
							<div class="w-6 h-6 bg-red-500/20 border border-red-500 flex items-center justify-center flex-shrink-0 mt-1">
								<X size={14} class="text-red-500" />
							</div>
							<p class="text-off-white/90 text-base leading-[1.6]">回應慢，工作慢，周末及假期「老馮」搵唔到人 </p>
						</li>
					</ul>
				</div>

				<div class="neo-brutalism-card p-10 bg-aqua-mint/10 border-aqua-mint/30 reveal">
					<h3 class="font-display font-black text-2xl mb-8 text-aqua-mint">2xWin</h3>
					<ul class="space-y-6">
						<li class="flex items-start space-x-4">
							<div class="w-6 h-6 bg-green-500/20 border border-green-500 flex items-center justify-center flex-shrink-0 mt-1">
								<Plus size={14} class="text-green-500" />
							</div>
							<p class="text-off-white/90 text-base leading-[1.6]">樂意用你帳戶直接操作，唔怕你睇真實數據，唔怕你知setting，百分百透明</p>
						</li>
						<li class="flex items-start space-x-4">
							<div class="w-6 h-6 bg-green-500/20 border border-green-500 flex items-center justify-center flex-shrink-0 mt-1">
								<Plus size={14} class="text-green-500" />
							</div>
							<p class="text-off-white/90 text-base leading-[1.6]">不綁約，月月清，靠實力留客</p>
						</li>
						<li class="flex items-start space-x-4">
							<div class="w-6 h-6 bg-green-500/20 border border-green-500 flex items-center justify-center flex-shrink-0 mt-1">
								<Plus size={14} class="text-green-500" />
							</div>
							<p class="text-off-white/90 text-base leading-[1.6]">隔天監控數據，持續優化設定</p>
						</li>
						<li class="flex items-start space-x-4">
							<div class="w-6 h-6 bg-green-500/20 border border-green-500 flex items-center justify-center flex-shrink-0 mt-1">
								<Plus size={14} class="text-green-500" />
							</div>
							<p class="text-off-white/90 text-base leading-[1.6]">固定收費，落幾多都統一收費，商業思維先行，會建議你適當時機進攻、需要時防守，不盲目加budget</p>
						</li>
							<li class="flex items-start space-x-4">
							<div class="w-6 h-6 bg-green-500/20 border border-green-500 flex items-center justify-center flex-shrink-0 mt-1">
								<Plus size={14} class="text-green-500" />
							</div>
							<p class="text-off-white/90 text-base leading-[1.6]">回應神速，工作效率驚人，年初一都搵到人</p>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Case Studies Section -->
	<section id="case-studies" class="py-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="max-w-3xl mb-16">
				<h2 class="font-display font-black text-3xl md:text-5xl mb-6 reveal">
					睇吓我哋幫客戶達成嘅實戰結果
				</h2>
				<AEOBlock content="2xWin 的 Meta 廣告實戰案例涵蓋了零售、教育及美容等多個行業。我們通過精準的受眾定位、高轉化素材策略及數據驅動的優化流程，幫助客戶實現了 ROAS 提升 200%-400%、獲客成本降低 50% 等顯著成效。每一個案例都證明了我們「透明、穩陣、講真話」的服務價值。" />
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-12">
				{caseStudies.map(study => (
					<div class="min-w-0 neo-brutalism-card group reveal">
						<div class="relative aspect-square border-b-2 border-black">
							<img 
								src={study.image} 
								alt={study.title} 
								class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
								referrerpolicy="no-referrer"
							/>
						</div>
						<div class="p-8">
							<div class="flex flex-wrap gap-2 mb-4">
								{study.tags.map(tag => (
									<span class="px-2 py-1 bg-light-gray border border-black text-[10px] font-display font-black uppercase tracking-wider">
										{tag}
									</span>
								))}
							</div>
							<h3 class="font-display font-black text-2xl mb-4">{study.title}</h3>
							
						  
							
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- FAQ -->
	<section class="py-24 bg-light-gray">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="font-display font-black text-3xl md:text-5xl text-center mb-16 reveal">
				關於 Meta 廣告嘅常見問題
			</h2>
			<FAQAccordion items={metaAdsFaqs} />
		</div>
	</section>

	<!-- Final CTA -->
	<section class="py-24 bg-aqua-mint border-y-4 border-black">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h2 class="font-display font-black text-4xl md:text-6xl mb-8 reveal">
				準備好開始穩陣放大生意？
			</h2>
			<p class="text-xl md:text-2xl mb-12 text-charcoal/80 reveal">
				唔好再浪費 Budget 喺無效嘅廣告上面。
			</p>
			<div class="flex justify-center reveal">
				<a href="https://api.whatsapp.com/send/?phone=85252232817&text=%E6%83%B3%E6%9F%A5%E8%A9%A2%E3%80%8C%E7%B7%9A%E4%B8%8A%E5%BB%A3%E5%91%8A%E3%80%8D%E6%9C%8D%E5%8B%99+%28%E6%9F%A5%E8%A9%A2%E7%B7%A8%E8%99%9F%3A+%23225361%29&type=phone_number&app_absent=0" target="_blank" class="neo-brutalism-button bg-charcoal text-white text-2xl py-6 px-12 flex items-center space-x-4">
					<Image src={whatsapp} alt="WhatsApp" class="w-8 h-8" />
					<span>免費獲取 Meta 廣告診斷</span>
				</a>
			</div>
		</div>
	</section>
</Layout>
