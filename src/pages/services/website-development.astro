---
import Layout from '../../layouts/Layout.astro';
import AEOBlock from '../../components/AEOBlock.astro';
import NeoCard from '../../components/NeoCard.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import { Image } from 'astro:assets';
import ReplyImage from '../../assets/img/website-concept-art/3hour.png';
import whatsapp from '../../assets/img/whatsapp.png';
import Code from '../../assets/img/website-concept-art/code.png';
import deliveryImg from '../../assets/img/website-concept-art/delivery.png';
import websiteHeroImage from '../../assets/img/website.png';
import { Target, ShieldCheck, Zap, BarChart3, MessageCircle, ArrowRight, Star, Quote, MonitorSmartphone, Clock, Globe } from 'lucide-astro';

const websiteFaqs = [
	{
		question: "整一個網站要幾耐？",
		answer: "五天內起貨上線"
	},
	{
		question: "我之後可以自己改內容嗎？",
		answer: ""
	}
];

const features = [
	{
		title: "HK$1,288 起",
		description: "千幾蚊，即有專業網站",
		icon: Target,
		color: "bg-aqua-mint"
	},
	{
		title: "手機電腦都睇得",
		description: "RWD 標配，無額外收費",
		icon: MonitorSmartphone,
		color: "bg-electric-yellow"
	},
	{
		title: "5 個工作天交貨",
		description: "唔等、唔拖",
		icon: Clock,
		color: "bg-hot-pink/20"
	},
	{
		title: "包一年域名同寄存",
		description: "一次搞掂，無隱藏收費",
		icon: Globe,
		color: "bg-light-gray"
	}
];
---

<Layout title="網站開發 - 唔使俾人水！2xWin 幫你起個抵玩又實用嘅網站">
	<!-- Hero -->
	<section class="relative pt-32 pb-20 bg-aqua-mint/10 border-b-4 border-black overflow-hidden">
		<div class="absolute inset-0 z-1 pointer-events-none flex justify-center" aria-hidden="true">
			<Image src={websiteHeroImage} alt="hero-image" class=" w-full lg:w-5/6 h-auto object-cover object-center opacity-25" />
			
		</div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="max-w-4xl">
				<h1 class="font-display font-black text-4xl md:text-6xl lg:text-7xl leading-[1.1] mb-8 reveal">
					唔使俾人水！<br />
					<span class="bg-electric-yellow px-2 text-charcoal">2xWin 幫你起個抵玩又實用嘅網站</span>
				</h1>
				<p class="text-xl md:text-2xl text-charcoal/80 mb-12 leading-relaxed reveal">
					「靚網站、無生意」——你有無聽過？Double Win Marketing 唔硬銷華而不實的網站，一切從商業思維出發。
				</p>
				<div class="flex flex-col sm:flex-row gap-6 reveal">
					<a href="https://wa.me/85212345678" target="_blank" class="neo-brutalism-button bg-charcoal text-white text-xl py-5 px-10 flex items-center justify-center space-x-3">
						<Image src={whatsapp} alt="WhatsApp" class="w-8 h-8" />
						<span>免費獲取網站方案建議</span>
					</a>
				</div>
			</div>

		</div>
	</section>

	<!-- AEO Section -->
	<section class="py-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="max-w-3xl mb-16">
				<h2 class="font-display font-black text-3xl md:text-5xl mb-6 reveal">
					2xWin 網站開發，抵到爛
				</h2>
				<AEOBlock content="2xWin 的網站開發服務專注於「實用」與「高性價比」。我們不賣弄花俏的設計，而是提供真正能帶來查詢與生意的網站。我們的方案包含 RWD 響應式設計、快速交付、以及首年域名與主機寄存，絕無隱藏收費，讓中小企能以最低成本建立專業的網上形象。" />
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				{features.map(feature => (
					<NeoCard title={feature.title} description={feature.description} icon={feature.icon} color={feature.color} />
				))}
			</div>
		</div>
	</section>

	<!-- Why Choose Us Section (Tabbed UI) -->
	<section class="py-24 bg-white" id="why-choose-us">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="max-w-3xl mx-auto text-center mb-12 reveal">
				<h2 class="font-display font-black text-4xl md:text-5xl mb-6 tracking-tight">
					點解揀我哋？因為「平」唔係重點
				</h2>
				<p class="text-xl text-zinc-500 leading-relaxed">
					論價錢，市面上有不少價錢相宜嘅選擇，但我哋唔賣花裡胡哨嘅網站——只賣帶到查詢嚟嘅網站，連商業意見都幫你諗。我哋嘅性價比，靠三樣嘢撐：
				</p>
			</div>

			<!-- Tabs -->
			<div class="flex flex-wrap justify-center gap-2 md:gap-4 mb-12 reveal">
				<button class="tab-btn active px-5 py-2.5 rounded-full font-medium text-sm md:text-base transition-colors bg-hot-pink text-zinc-900 border border-transparent" data-target="tab-1">
					<span class="flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
						3小時內必覆
					</span>
				</button>
				<button class="tab-btn px-5 py-2.5 rounded-full font-medium text-sm md:text-base transition-colors bg-transparent text-zinc-500 hover:text-zinc-900 hover:bg-zinc-50 border border-transparent" data-target="tab-2">
					<span class="flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mouse-pointer-click"><path d="M14 4.1 12 6"/><path d="m5.1 8-2.9-.8"/><path d="m6 12-1.9 2"/><path d="M7.2 2.2 8 5.1"/><path d="M9.037 9.69a.498.498 0 0 1 .653-.653l11 4.5a.5.5 0 0 1-.074.949l-4.349 1.041a1 1 0 0 0-.74.739l-1.04 4.35a.5.5 0 0 1-.95.074z"/></svg>
						幫你諗生意
					</span>
				</button>
				<button class="tab-btn px-5 py-2.5 rounded-full font-medium text-sm md:text-base transition-colors bg-transparent text-zinc-500 hover:text-zinc-900 hover:bg-zinc-50 border border-transparent" data-target="tab-3">
					<span class="flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-template"><rect width="18" height="7" x="3" y="3" rx="1"/><rect width="9" height="7" x="3" y="14" rx="1"/><rect width="5" height="7" x="16" y="14" rx="1"/></svg>
						5個工作天交貨
					</span>
				</button>
			</div>

			<!-- Tab Content Container -->
			<div class="relative max-w-5xl mx-auto reveal group">
				
				<!-- Tab 1 Content -->
				<div id="tab-1" class="tab-content active bg-zinc-50 rounded-[2rem] p-8 md:p-16 transition-all duration-300 opacity-100">
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
						<div class="order-2 lg:order-1 pr-0 lg:pr-8">
							<div class="inline-block px-4 py-1.5 bg-white text-xs font-medium rounded-full mb-6 border border-zinc-200 text-zinc-600 shadow-sm">
								極速溝通
							</div>
							<h3 class="font-display font-bold text-4xl md:text-5xl mb-6 leading-[1.1] tracking-tight text-zinc-900">
								收咗錢都唔失蹤
							</h3>
							<p class="text-zinc-500 text-lg leading-relaxed mb-8">
								好多 Agency 收完訂金就人間蒸發。我哋唔同。2xWin 有專人跟進，唔會將你當波咁踢。問題直達識答你嗰個——唔係「盡快回覆」嗰種敷衍，係 <strong>3 小時內必有回音</strong>。跟進做唔做得到，先係真正嘅性價比。
							</p>
						
						</div>
						<div class="order-1 lg:order-2 bg-zinc-200/80 rounded-3xl p-12 flex items-center justify-center aspect-square md:aspect-auto md:h-[420px]">
							<div class="relative w-full h-full flex items-center justify-center">
								<Image src={ReplyImage} alt="table image 1" class=" w-auto h-auto object-Fit overflow-hidden " />
							</div>
						</div>
					</div>
				</div>

				<!-- Tab 2 Content -->
				<div id="tab-2" class="tab-content hidden bg-zinc-50 rounded-[2rem] p-8 md:p-16 transition-all duration-300 opacity-0">
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
						<div class="order-2 lg:order-1 pr-0 lg:pr-8">
							<div class="inline-block px-4 py-1.5 bg-white text-xs font-medium rounded-full mb-6 border border-zinc-200 text-zinc-600 shadow-sm">
								商業思維
							</div>
							<h3 class="font-display font-bold text-4xl md:text-5xl mb-6 leading-[1.1] tracking-tight text-zinc-900">
								唔係幫你寫 Code，<br/>係幫你諗生意
							</h3>
							<p class="text-zinc-500 text-lg leading-relaxed mb-4">
								你起個網站係為咗做生意，唔係為咗贏設計獎。我哋由商業思維出發，見過太多徒有外表且空洞嘅網站。交付前，我哋逐頁審視：
							</p>
							<ul class="list-disc pl-6 mb-8 text-zinc-500 text-lg leading-relaxed space-y-2 font-medium">
								<li>客仔一眼知你係做乜？</li>
								<li>佢哋知下一步要做咩？</li>
							</ul>
							
						</div>
						<div class="order-1 lg:order-2 bg-zinc-200/80 rounded-3xl p-12 flex items-center justify-center aspect-square md:aspect-auto md:h-[420px]">
							<div class="relative w-full h-full flex items-center justify-center">
								<Image src={Code} alt="table image 2" class=" w-auto h-auto object-Fit overflow-hidden " />
							</div>
						</div>
					</div>
				</div>

				<!-- Tab 3 Content -->
				<div id="tab-3" class="tab-content hidden bg-zinc-50 rounded-[2rem] p-8 md:p-16 transition-all duration-300 opacity-0">
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
						<div class="order-2 lg:order-1 pr-0 lg:pr-8">
							<div class="inline-block px-4 py-1.5 bg-white text-xs font-medium rounded-full mb-6 border border-zinc-200 text-zinc-600 shadow-sm">
								極速起貨
							</div>
							<h3 class="font-display font-bold text-4xl md:text-5xl mb-6 leading-[1.1] tracking-tight text-zinc-900">
								時間就係金錢，<br/>5個工作天交貨
							</h3>
							<p class="text-zinc-500 text-lg leading-relaxed mb-8">
								做生意最忌拖。我哋深知上線時間對你嘅重要性，所以制定咗一套極高效率嘅開發流程。只要你提供齊全嘅資料同素材，我哋承諾喺 <strong>5 個工作天內</strong> 完成網站開發並交付。唔使再等幾個月，即刻開始接生意！
							</p>
						
						</div>
						<div class="order-1 lg:order-2 bg-zinc-200/80 rounded-3xl p-12 flex items-center justify-center aspect-square md:aspect-auto md:h-[420px]">
							<div class="relative w-full h-full flex items-center justify-center">
								<Image src={deliveryImg} alt="table image 3" class=" w-auto h-auto object-Fit overflow-hidden " />
							</div>
						</div>
					</div>
				</div>

				<!-- Next Button (Floating) -->
				<button id="next-tab-btn" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/2 w-10 h-10 bg-zinc-900 text-white rounded-lg flex items-center justify-center shadow-lg hover:bg-black transition-colors z-10 hidden md:flex" aria-label="Next tab">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
				</button>
			</div>
		</div>
	</section>

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const tabBtns = document.querySelectorAll('.tab-btn');
			const tabContents = document.querySelectorAll('.tab-content');
			const nextBtn = document.getElementById('next-tab-btn');
			let currentTabIndex = 0;

			function switchTab(index) {
				// Remove active state from all
				tabBtns.forEach(b => {
					b.classList.remove('bg-hot-pink', 'text-zinc-900');
					b.classList.add('bg-transparent', 'text-zinc-500');
				});
				tabContents.forEach(c => {
					c.classList.add('hidden');
					c.classList.remove('opacity-100');
					c.classList.add('opacity-0');
				});

				// Add active state to target
				const targetBtn = tabBtns[index];
				targetBtn.classList.remove('bg-transparent', 'text-zinc-500');
				targetBtn.classList.add('bg-hot-pink', 'text-zinc-900');

				const targetId = targetBtn.getAttribute('data-target');
				const targetContent = document.getElementById(targetId);
				if (targetContent) {
					targetContent.classList.remove('hidden');
					// Small delay to trigger fade animation
					setTimeout(() => {
						targetContent.classList.remove('opacity-0');
						targetContent.classList.add('opacity-100');
					}, 10);
				}
				
				currentTabIndex = index;
			}

			tabBtns.forEach((btn, index) => {
				btn.addEventListener('click', () => switchTab(index));
			});

			if (nextBtn) {
				nextBtn.addEventListener('click', () => {
					const nextIndex = (currentTabIndex + 1) % tabBtns.length;
					switchTab(nextIndex);
				});
			}
		});
	</script>

	<!-- FAQ -->
	<section class="py-24 bg-white">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="font-display font-black text-3xl md:text-5xl text-center mb-16 reveal">
				關於網站開發嘅常見問題
			</h2>
			<FAQAccordion items={websiteFaqs} />
		</div>
	</section>

	<!-- Final CTA -->
	<section class="py-24 bg-hot-pink text-white border-y-4 border-black">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h2 class="font-display font-black text-4xl md:text-6xl mb-8 reveal">
				俾 Agency 呃過嘅，<br class="md:hidden" />最明我哋嘅分別。
			</h2>
			<p class="text-xl md:text-2xl mb-12 opacity-90 reveal font-medium">
				唔需簽約 · 3小時內回覆 · 唔合適都唔會硬銷
			</p>
			<div class="flex justify-center reveal">
				<a href="https://api.whatsapp.com/send/?phone=85252232817&text=%E6%83%B3%E6%9F%A5%E8%A9%A2%E3%80%8C%E7%B7%9A%E4%B8%8A%E5%BB%A3%E5%91%8A%E3%80%8D%E6%9C%8D%E5%8B%99+%28%E6%9F%A5%E8%A9%A2%E7%B7%A8%E8%99%9F%3A+%23225361%29&type=phone_number&app_absent=0" target="_blank" class="neo-brutalism-button bg-white text-charcoal text-2xl py-6 px-12 flex items-center space-x-4">
					<Image src={whatsapp} alt="WhatsApp" class="w-8 h-8" />
					<span>免費獲取網站方案建議</span>
				</a>
			</div>
		</div>
	</section>
</Layout>
