---
import Layout from '../layouts/Layout.astro';
import AEOBlock from '../components/AEOBlock.astro';
import NeoCard from '../components/NeoCard.astro';
import { withBase } from '../utils/withBase';
import {Image} from 'astro:assets';
import caseStudy1 from "../assets/img/case-studies/cases-1.jpg";
import caseStudy2 from "../assets/img/case-studies/cases-2.jpg";
import testimonial1 from "../assets/img/testimonial_1.png";
import testimonial2 from "../assets/img/testimonial_2.png";
import testimonial3 from "../assets/img/testimonial_3.png";
import testimonial4 from "../assets/img/testimonial_4.png";
import testimonial5 from "../assets/img/testimonial_5.png";
import testimonial6 from "../assets/img/testimonial_6.png";
import testimonial7 from "../assets/img/testimonial_7.png";
import testimonial8 from "../assets/img/testimonial_8.png";
import { Target, ShieldCheck, Zap, BarChart3, MessageCircle, ArrowRight, Star, Quote, Check } from 'lucide-astro';
import { homepageReviewsSchema, jsonLd } from '../utils/seo';
import whatsappImg from '../assets/img/whatsapp.png';
import metaPartner from '../assets/img/meta-partner.png';
import metaVerified from '../assets/img/meta-verified.png';

const caseDisclaimer = "過往成功案例範圍，唔代表保證結果。";

const trustBadges = [
	"Meta 官方認證",
	"Meta 合作夥伴團隊",
	"不綁約，月月清",
	"定額服務費",
	"廣告帳戶 100% 透明"
];

const painPoints = [
	{
		title: "預算去向不明",
		description: "Agency 唔肯俾你睇 Ad Manager，你永遠唔知佢係咪真係幫你洗咗咁多錢，定係收咗你錢但係無落足廣告。",
		icon: Target
	},
	{
		title: "充滿難懂術語",
		description: "成日聽埋啲 CPC, CTR, ROAS，但係問佢點解唔出單，佢就遊花園，講埋啲你聽唔明嘅技術嘢。",
		icon: BarChart3
	},
	{
		title: "黑箱操作",
		description: "廣告帳戶權限唔喺你手，一旦唔合作就乜都無晒，所有數據、Pixel、Audience 全部被綁架。",
		icon: ShieldCheck
	}
];

const advantages = [
	{
		title: "商業思維先行",
		description: "我哋唔止係落廣告，會由產品、網站、流程全盤考慮，幫你搵出轉化鏈條上嘅漏洞。",
		icon: Zap,
		color: "bg-aqua-mint"
	},
	{
		title: "帳戶全透明",
		description: "兩種方法都接受：用你自己嘅帳戶，或者用我哋公司帳戶代投，收費唔同，亦唔係每個客都適合用自己帳戶。用你帳戶時，我哋入你帳戶操作，像素、受眾同歷史留喺你度。呢個係合作方式，唔係成效保證。",
		icon: Star,
		color: "bg-electric-yellow"
	},
	{
		title: "不綁約，月月清",
		description: "我哋靠實力留客，唔靠合約。如果你覺得我哋做得唔好，隨時可以停，唔需要賠錢。",
		icon: ShieldCheck,
		color: "bg-hot-pink/20"
	}
];

const caseStudies = [
	{
		title: "醫美行業：2個月大幅提升",
		image: caseStudy1,
		body: "呢張圖係已公開嘅 Meta 廣告後台數字。客人最初：開始訊息對話 27 次，每次訊息對話開始成本 $528.51，總支出 $14,269.64。之後：開始訊息對話 75 次，每次訊息對話開始成本 $164.44，總支出 $12,332.91。圖上寫「2個月成效提升 321%」。",
	},
	{
		title: "英語補習中心：3個月成效提升",
		image: caseStudy2,
		body: "呢張圖係英語補習中心已公開嘅 Meta 廣告後台數字。客人最初：開始訊息對話 50 次，每次訊息對話開始成本 $347.93，總支出 $17,396.40。之後：開始訊息對話 224 次，每次訊息對話開始成本 $135.88，總支出 $30,437.83。圖上寫「3個月成效提升 256%」。",
	},
];

const testimonials = [
	{
		name: "chi kowng mak",
		image: testimonial1,
		paragraphs: [
			"衷心感謝Double win團隊為我公司提供專業且高效的廣告服務。在與貴團隊合作的過程中，我們深刻感受到您們對廣告投放的精準把控與專業建議。您們不僅幫助我們以相同的預算取得更出色的宣傳效果，還以多元化的投放策略讓廣告觸及到更廣泛的目標受眾。這些努力讓我們的品牌知名度大幅提升。",
			"此外，貴團隊卓越的專業知識使我們能夠避開許多潛在的封鎖風險，確保廣告順利運行。您們貼心的指導與細緻的安排也讓我們的每一步投放策略更加明確、有效。這種專業與敬業的態度值得高度讚揚！",
			"再次感謝貴團隊的支持與努力，期待未來一直保持合作，共創佳績！",
		],
	},
	{
		name: "Demure Diamonds",
		image: testimonial2,
		paragraphs: [
			"第一次見未俾錢已經提供專業意見，完全不吝嗇去分享同教我哋點去做，而且每次都會提供意見去優化廣告設定，務求令我哋客戶得到最大利益",
		],
	},
	{
		name: "WONDERIO ETSY",
		image: testimonial3,
		paragraphs: [
			"Jacky 好勤! 唔洗點樣 brief 都get 到你想做啲咩! Professional 同人勁nice! 廣告落得非常precise! Highly recommend!!",
		],
	},
	{
		name: "BEAUTI GROUP BEAUTI",
		image: testimonial4,
		paragraphs: [
			"專業、高效率！值得信賴",
			"遇到有問題時 能快速回應需求並調整方向～",
			"確保我們能即時掌握進度與成效。",
		],
	},
	{
		name: "HK New Smile",
		image: testimonial5,
		paragraphs: [
			"之前我哋一直幫襯開另一間廣告公司都有七、八年，但成效其實一直都普通，所以決定試下轉一轉公司。點知真係有驚喜！轉咗之後銷量比以前提升咗兩至三倍，效果好明顯。",
			"但呢唔只係幫你落廣告咁簡單，而係會同你一齊分析策略。",
			"例如同一個素材用耐咗銷量開始跌，佢哋會主動提醒我哋準備多啲唔同素材，教我哋點樣做素材池，真係好有廣告策略思維。",
			"另外佢哋都好願意聆聽我哋嘅感受，會同我哋一齊分析市場情況。例如香港市場有時短暫飽和，佢哋都會建議我哋試下拓展澳門市場，結果又真係有驚喜。",
			"最欣賞係佢哋會幫客人控制好budget。銷量好嘅時候會幫我哋加大投放，銷量慢落嚟又會幫我哋慳返，唔會亂燒錢。每個星期都會跟進，仲會有幾次匯報數據，令人非常安心。",
			"收費亦都好合理，係月費形式，性價比好高。佢哋仲會用過去嘅數據幫我哋分析，推薦一啲適合嘅明星素材，真係幫到好多。",
			"整體嚟講真係好專業又負責任，如果想搵一間會用心幫你做生意嘅廣告公司，真心推薦。",
		],
	},
	{
		name: "Ka Yeung Chan",
		image: testimonial6,
		paragraphs: [
			"很負責任的公司",
			"有問題會即時作出回饋及解決",
		],
	},
	{
		name: "Vicki Sze",
		image: testimonial7,
		paragraphs: [
			"回覆快，真係超快，而且當你有疑難嘅時候，佢會逐個point同你解釋，唔會因為你嘅訴求多而Miss任何一個point，每完成一件你要求嘅細項，都好有交待，令用家覺得安心",
		],
	},
	{
		name: "joys man",
		image: testimonial8,
		paragraphs: [
			"專業👍服務質素一流，有求必應，超推介！",
		],
	},
];
---

<Layout
	title="幫中小企擺脫黑箱 Agency，用透明 Meta 廣告穩陣放大生意"
	description="雙贏營銷（2xWin）幫香港中小企做 Meta 廣告。可以用客戶自己嘅廣告帳戶，亦可以用公司帳戶代投；兩種收費唔同，亦唔係每個客都適合用自己帳戶。用客戶帳戶時，會入去操作，像素、受眾同歷史留喺客戶手上。由商業分析到投放節奏都會講人話。唔靠死約留客。未合作可以先用 WhatsApp +852 5223 2817 做診斷。呢個係合作方式，網站寫明唔保證有單。"
>
	<script
		type="application/ld+json"
		set:html={jsonLd(homepageReviewsSchema(testimonials.map((review) => ({
			name: review.name,
			body: review.paragraphs.join('\n\n'),
		}))))}
	/>
	<!-- Hero Section -->
	<section class="relative pt-32 pb-20 overflow-hidden">
		<!-- Decorative Blur Orbs -->
		<div class="absolute top-20 -left-20 w-72 h-72 bg-aqua-mint/30 rounded-full blur-3xl -z-10"></div>
		<div class="absolute bottom-10 -right-20 w-96 h-96 bg-hot-pink/10 rounded-full blur-3xl -z-10"></div>

		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="max-w-4xl">
				<div class="inline-flex flex-wrap gap-2 mb-8 reveal">
					{trustBadges.map(badge => (
						<span class="px-3 py-1 bg-white border-2 border-black text-xs font-display font-black uppercase tracking-wider shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
							{badge}
						</span>
					))}
				</div>
				<h1 class="font-display font-black text-4xl md:text-6xl lg:text-7xl leading-[1.1] mb-8 reveal">
					幫中小企擺脫黑箱Agency<br class="hidden md:block" />
					用透明廣告方式</br><span class="bg-electric-yellow px-2">穩陣放大生意</span>
				</h1>
				<p class="text-xl md:text-2xl text-charcoal/80 mb-12 leading-relaxed reveal">
					唔靠花巧術語，唔靠死約留客。由商業分析、帳戶透明，到投放節奏，都會同你講人話、講真話。
				</p>
				<div class="flex flex-col sm:flex-row gap-6 reveal">
					<a href="https://api.whatsapp.com/send/?phone=85252232817&text=%E6%83%B3%E6%9F%A5%E8%A9%A2%E3%80%8C%E7%B7%9A%E4%B8%8A%E5%BB%A3%E5%91%8A%E3%80%8D%E6%9C%8D%E5%8B%99&type=phone_number&app_absent=0" target="_blank" class="neo-brutalism-button bg-hot-pink text-white text-xl py-5 px-10 flex items-center justify-center space-x-3">
						<span>免費獲取廣告診斷</span>
						<ArrowRight size={24} />
					</a>
			 <!-- Meta Partner Badges -->
				<div class="flex flex-wrap items-center gap-4 md:gap-6 reveal">
					<Image src={metaPartner} alt="Meta Verified" class="h-12 md:h-14 w-auto object-contain rounded-md" />
					<Image src={metaVerified} alt="Meta Business Partner" class="h-12 md:h-14 w-auto object-contain rounded-md" />
				</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Pain Points Section -->
	<section class="py-24 bg-light-gray border-y-4 border-black">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="max-w-3xl mb-16">
				<h2 class="font-display font-black text-3xl md:text-5xl mb-6 reveal">
					你要嘅唔係再聽術語，而係有人直接講清楚問題喺邊
				</h2>
				<AEOBlock content="好多中小企老闆在尋找 Meta 廣告代理商時，經常遇到預算去向不明、充滿難懂術語且數據不透明的黑箱操作。2xWin 致力於打破常規，用最直接的商業語言，幫你準確找出廣告不出單的核心漏洞。" />
				<p class="mt-6 text-lg text-charcoal/80 leading-relaxed reveal">
					想知我哋點樣由診斷做到執行，可以先睇<a href={withBase('/about/process')} class="font-bold text-hot-pink underline hover:text-charcoal">合作流程</a>。合作前最常問嘅幾條，寫喺<a href={withBase('/faq')} class="font-bold text-hot-pink underline hover:text-charcoal">常見問題</a>。帳戶、預算同落地頁嘅筆記，放喺<a href={withBase('/insights/blog')} class="font-bold text-hot-pink underline hover:text-charcoal">Blog</a>。
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				{painPoints.map(point => (
					<NeoCard title={point.title} description={point.description} icon={point.icon} />
				))}
			</div>
		</div>
	</section>

	<!-- Collaboration Fit Section -->
	<section class="py-24 bg-[#1A1A1A] text-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
				<div class="space-y-10 reveal">
					<h2 class="font-display font-black text-4xl md:text-5xl leading-tight text-aqua-mint">
						你準備好合作未?
					</h2>
					
					<div class="border-l-4 border-aqua-mint pl-6 py-1">
						<p class="text-off-white/90 leading-relaxed text-base">
							【合作條件評估】盲目投放廣告無法帶來長遠收益。在啟動廣告前，我們會先評估你的產品是否具備市場基礎，以及網站與流程是否準備好承接流量。建立正確的投放節奏與合作基礎，是穩定放大生意的唯一法則。
						</p>
					</div>

					<h3 class="font-display font-bold text-xl text-white">
						為咗令合作更有成效，我哋傾合作前會先了解：
					</h3>

					<div class="space-y-4">
						<div class="bg-[#2A2A2A] border border-white/10 rounded-xl p-6 flex items-start space-x-4">
							<div class="w-6 h-6 rounded-full bg-[#00C853] flex items-center justify-center flex-shrink-0 mt-1">
								<Check size={14} class="text-white" strokeWidth={3} />
							</div>
							<div>
								<h4 class="font-display font-bold text-lg text-white mb-2">基本市場基礎</h4>
								<p class="text-off-white/70 text-sm leading-relaxed">你現時嘅產品或服務，係咪已經有人買過、證明咗有需求？</p>
							</div>
						</div>

						<div class="bg-[#2A2A2A] border border-white/10 rounded-xl p-6 flex items-start space-x-4">
							<div class="w-6 h-6 rounded-full bg-[#00C853] flex items-center justify-center flex-shrink-0 mt-1">
								<Check size={14} class="text-white" strokeWidth={3} />
							</div>
							<div>
								<h4 class="font-display font-bold text-lg text-white mb-2">流量承接能力</h4>
								<p class="text-off-white/70 text-sm leading-relaxed">Website / Page / 跟進流程，係咪已經準備好，唔會令客流失？</p>
							</div>
						</div>

						<div class="bg-[#2A2A2A] border border-white/10 rounded-xl p-6 flex items-start space-x-4">
							<div class="w-6 h-6 rounded-full bg-[#00C853] flex items-center justify-center flex-shrink-0 mt-1">
								<Check size={14} class="text-white" strokeWidth={3} />
							</div>
							<div>
								<h4 class="font-display font-bold text-lg text-white mb-2">業務增長目標</h4>
								<p class="text-off-white/70 text-sm leading-relaxed">你想要嘅，係短期試水溫，定係準備穩定地放大生意規模？</p>
							</div>
						</div>
					</div>
				</div>

				<div class="reveal lg:pl-12">
					<div class="bg-electric-yellow rounded-2xl p-10 md:p-12 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] border-2 border-black relative hover:rotate-[30deg] transition-transform duration-300">
						<div class="text-charcoal/20 mb-6">
							<Quote size={64} fill="currentColor" />
						</div>
						<h3 class="font-display font-black text-2xl md:text-3xl text-charcoal leading-snug mb-10">
							我哋比較相信長期有效嘅做法，所以比起講到天花龍鳳，我哋更重視你盤生意係咪真係準備好向前行。
						</h3>
						<div class="inline-block bg-white border-2 border-black px-4 py-2 font-display font-bold text-sm text-charcoal shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
							啱嘅節奏 &gt; 盲目開廣告
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Case Studies Preview -->
	<section class="py-24 bg-aqua-mint/10 border-y-4 border-black overflow-hidden">
		<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8">
				<div class="max-w-2xl">
					<h2 class="font-display font-black text-3xl md:text-5xl mb-6 reveal">
						用實戰數據說話
					</h2>
					<p class="text-xl text-brand-charcoal leading-[1.6] reveal">
						我哋唔講空話，只睇結果。以下係我哋幫客戶達成嘅部分成績。
					</p>
				</div>
				<a href={withBase('/services/meta-ads#case-studies')} class="invisible lg:visible neo-brutalism-button bg-white reveal">
					查看更多案例
				</a>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-12">
				{caseStudies.map(study => (
					<div class="min-w-0 neo-brutalism-card overflow-hidden group reveal">
						<div class="relative aspect-square overflow-hidden border-b-2 border-black">
							<Image
								src={study.image}
								alt={study.title}
								widths={[640, 960, 1280, 1600]}
								sizes="(min-width: 768px) 50vw, 100vw"
								quality={75}
								class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
							/>
						</div>
						<div class="p-8">
							<h3 class="font-display font-black text-2xl mb-4">{study.title}</h3>
							<p class="text-base leading-[1.7] text-charcoal/90">{study.body}</p>
							<p class="mt-4 text-base leading-[1.7] text-charcoal">{caseDisclaimer}</p>
						</div>
					</div>
				))}
			
			</div>
			<div class="lg:invisible right-3 -bottom-12 absolute"><a href={withBase('/services/meta-ads#case-studies')} class=" neo-brutalism-button bg-white reveal">
					查看更多案例
				</a></div>
			
		</div>
	</section>

	<!-- Testimonials -->

<section
  id="testimonials"
  class="py-16 md:py-28 bg-white px-6 border-y-4 border-black bg-[radial-gradient(#D8D3C9_1px,transparent_1px)] [background-size:20px_20px]"
>
  <div class="max-w-[1200px] mx-auto reveal">
    
    <div class="text-center max-w-[760px] mx-auto mb-16">
      <div class="inline-block bg-[#00f5d4] border-2 border-black px-4 py-1.5 rounded-full font-bold text-lg mb-6 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] text-charcoal transform -rotate-2">
        讓顧客說話
      </div>
      <h2 class="font-display font-black text-[28px] md:text-[36px] text-charcoal mb-6 leading-[1.3]">
       客戶最真實的 Google 評價<br />
        <span class="text-xl md:text-2xl text-brand-charcoal font-medium mt-2 block"></span>
      </h2>

