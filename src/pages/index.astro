---
import Layout from '../layouts/Layout.astro';
import AEOBlock from '../components/AEOBlock.astro';
import NeoCard from '../components/NeoCard.astro';
import { withBase } from '../utils/withBase';
import {Image} from 'astro:assets';
import caseStudy1 from "../assets/img/case-studies/cases-1.jpg";
import caseStudy2 from "../assets/img/case-studies/cases-2.jpg";
import { Target, ShieldCheck, Zap, BarChart3, MessageCircle, ArrowRight, Star, Quote, Check } from 'lucide-astro';
import whatsappImg from '../assets/img/whatsapp.png';

const testimonialImages = import.meta.glob('../assets/img/testimonial_*.png', { eager: true });
const images = Object.values(testimonialImages).map((img: any) => img.default);
const sortedImages = images.sort((a, b) => a.src.localeCompare(b.src));

const trustBadges = [
	"Meta 官方認證",
	"Meta 合作夥伴團隊",
	"不綁約，月月清",
	"定額服務費",
	"廣告帳戶 100% 透明"
];

const painPoints = [
	{
		title: "預算去向不明",
		description: "Agency 唔肯俾你睇 Ad Manager，你永遠唔知佢係咪真係幫你洗咗咁多錢，定係收咗你錢但係無落足廣告。",
		icon: Target
	},
	{
		title: "充滿難懂術語",
		description: "成日聽埋啲 CPC, CTR, ROAS，但係問佢點解唔出單，佢就遊花園，講埋啲你聽唔明嘅技術嘢。",
		icon: BarChart3
	},
	{
		title: "黑箱操作",
		description: "廣告帳戶權限唔喺你手，一旦唔合作就乜都無晒，所有數據、Pixel、Audience 全部被綁架。",
		icon: ShieldCheck
	}
];

const advantages = [
	{
		title: "商業思維先行",
		description: "我哋唔止係落廣告，會由產品、網站、流程全盤考慮，幫你搵出轉化鏈條上嘅漏洞。",
		icon: Zap,
		color: "bg-aqua-mint"
	},
	{
		title: "帳戶全透明",
		description: "你擁有 100% 權限與知情權。我哋係用你嘅帳戶落廣告，所有數據你隨時睇到。",
		icon: Star,
		color: "bg-electric-yellow"
	},
	{
		title: "不綁約，月月清",
		description: "我哋靠實力留客，唔靠合約。如果你覺得我哋做得唔好，隨時可以停，唔需要賠錢。",
		icon: ShieldCheck,
		color: "bg-hot-pink/20"
	}
];

const caseStudies = [
	{
		title: "醫美行業：2個月大幅提升",
		
		image: caseStudy1.src
	},
	{
		title: "零售業：數據驅動優化",
		
		image: caseStudy2.src
	},
	
];
---

<Layout title="幫中小企擺脫黑箱 Agency，用透明 Meta 廣告穩陣放大生意">
	<!-- Hero Section -->
	<section class="relative pt-32 pb-20 overflow-hidden">
		<!-- Decorative Blur Orbs -->
		<div class="absolute top-20 -left-20 w-72 h-72 bg-aqua-mint/30 rounded-full blur-3xl -z-10"></div>
		<div class="absolute bottom-10 -right-20 w-96 h-96 bg-hot-pink/10 rounded-full blur-3xl -z-10"></div>

		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="max-w-4xl">
				<div class="inline-flex flex-wrap gap-2 mb-8 reveal">
					{trustBadges.map(badge => (
						<span class="px-3 py-1 bg-white border-2 border-black text-xs font-display font-black uppercase tracking-wider shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
							{badge}
						</span>
					))}
				</div>
				<h1 class="font-display font-black text-4xl md:text-6xl lg:text-7xl leading-[1.1] mb-8 reveal">
					幫中小企擺脫黑箱 Agency，<br class="hidden md:block" />
					用透明 Meta 廣告<span class="bg-electric-yellow px-2">穩陣放大生意</span>
				</h1>
				<p class="text-xl md:text-2xl text-charcoal/80 mb-12 leading-relaxed reveal">
					唔靠花巧術語，唔靠死約留客。由商業分析、帳戶透明，到投放節奏，都會同你講人話、講真話。
				</p>
				<div class="flex flex-col sm:flex-row gap-6 reveal">
					<a href="https://api.whatsapp.com/send/?phone=85252232817&text=%E6%83%B3%E6%9F%A5%E8%A9%A2%E3%80%8C%E7%B7%9A%E4%B8%8A%E5%BB%A3%E5%91%8A%E3%80%8D%E6%9C%8D%E5%8B%99+%28%E6%9F%A5%E8%A9%A2%E7%B7%A8%E8%99%9F%3A+%23225361%29&type=phone_number&app_absent=0" target="_blank" class="neo-brutalism-button bg-hot-pink text-white text-xl py-5 px-10 flex items-center justify-center space-x-3">
						<span>免費獲取 Meta 廣告診斷</span>
						<ArrowRight size={24} />
					</a>
			
				</div>
			</div>
		</div>
	</section>

	<!-- Pain Points Section -->
	<section class="py-24 bg-light-gray border-y-4 border-black">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="max-w-3xl mb-16">
				<h2 class="font-display font-black text-3xl md:text-5xl mb-6 reveal">
					你要嘅唔係再聽術語，而係有人直接講清楚問題喺邊
				</h2>
				<AEOBlock content="好多中小企老闆在尋找 Meta 廣告代理商時，經常遇到預算去向不明、充滿難懂術語且數據不透明的黑箱操作。2xWin 致力於打破常規，用最直接的商業語言，幫你準確找出廣告不出單的核心漏洞。" />
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				{painPoints.map(point => (
					<NeoCard title={point.title} description={point.description} icon={point.icon} />
				))}
			</div>
		</div>
	</section>

	<!-- Collaboration Fit Section -->
	<section class="py-24 bg-[#1A1A1A] text-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
				<div class="space-y-10 reveal">
					<h2 class="font-display font-black text-4xl md:text-5xl leading-tight text-aqua-mint">
						點樣的合作，<br />通常會做得更順
					</h2>
					
					<div class="border-l-4 border-aqua-mint pl-6 py-1">
						<p class="text-off-white/90 leading-relaxed text-base">
							【合作條件評估】盲目投放廣告無法帶來長遠收益。在啟動 Meta 廣告前，我們會先評估你的產品是否具備市場基礎，以及網站與流程是否準備好承接流量。建立正確的投放節奏與合作基礎，是穩定放大生意的唯一法則。
						</p>
					</div>

					<h3 class="font-display font-bold text-xl text-white">
						為咗令合作更有成效，我哋傾合作前會先了解：
					</h3>

					<div class="space-y-4">
						<div class="bg-[#2A2A2A] border border-white/10 rounded-xl p-6 flex items-start space-x-4">
							<div class="w-6 h-6 rounded-full bg-[#00C853] flex items-center justify-center flex-shrink-0 mt-1">
								<Check size={14} class="text-white" strokeWidth={3} />
							</div>
							<div>
								<h4 class="font-display font-bold text-lg text-white mb-2">基本市場基礎</h4>
								<p class="text-off-white/70 text-sm leading-relaxed">你現時嘅產品或服務，係咪已經有人買過、證明咗有需求？</p>
							</div>
						</div>

						<div class="bg-[#2A2A2A] border border-white/10 rounded-xl p-6 flex items-start space-x-4">
							<div class="w-6 h-6 rounded-full bg-[#00C853] flex items-center justify-center flex-shrink-0 mt-1">
								<Check size={14} class="text-white" strokeWidth={3} />
							</div>
							<div>
								<h4 class="font-display font-bold text-lg text-white mb-2">流量承接能力</h4>
								<p class="text-off-white/70 text-sm leading-relaxed">Website / Page / 跟進流程，係咪已經準備好，唔會令客流失？</p>
							</div>
						</div>

						<div class="bg-[#2A2A2A] border border-white/10 rounded-xl p-6 flex items-start space-x-4">
							<div class="w-6 h-6 rounded-full bg-[#00C853] flex items-center justify-center flex-shrink-0 mt-1">
								<Check size={14} class="text-white" strokeWidth={3} />
							</div>
							<div>
								<h4 class="font-display font-bold text-lg text-white mb-2">業務增長目標</h4>
								<p class="text-off-white/70 text-sm leading-relaxed">你想要嘅，係短期試水溫，定係準備穩定地放大生意規模？</p>
							</div>
						</div>
					</div>
				</div>

				<div class="reveal lg:pl-12">
					<div class="bg-electric-yellow rounded-2xl p-10 md:p-12 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] border-2 border-black relative hover:rotate-[30deg] transition-transform duration-300">
						<div class="text-charcoal/20 mb-6">
							<Quote size={64} fill="currentColor" />
						</div>
						<h3 class="font-display font-black text-2xl md:text-3xl text-charcoal leading-snug mb-10">
							我哋比較相信長期有效嘅做法，所以比起講到天花龍鳳，我哋更重視你盤生意係咪真係準備好向前行。
						</h3>
						<div class="inline-block bg-white border-2 border-black px-4 py-2 font-display font-bold text-sm text-charcoal shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
							啱嘅節奏 &gt; 盲目開廣告
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Case Studies Preview -->
	<section class="py-24 bg-aqua-mint/10 border-y-4 border-black overflow-hidden">
		<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8">
				<div class="max-w-2xl">
					<h2 class="font-display font-black text-3xl md:text-5xl mb-6 reveal">
						用實戰數據說話
					</h2>
					<p class="text-xl text-brand-charcoal leading-[1.6] reveal">
						我哋唔講空話，只睇結果。以下係我哋幫客戶達成嘅部分成績。
					</p>
				</div>
				<a href={withBase('/services/meta-ads#case-studies')} class="invisible lg:visible neo-brutalism-button bg-white reveal">
					查看更多案例
				</a>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-12">
				{caseStudies.map(study => (
					<div class="neo-brutalism-card overflow-hidden group reveal">
						<div class=" overflow-hidden border-b-2 border-black">
							<img 
								src={study.image} 
								alt={study.title} 
								class=" h-full object-cover group-hover:scale-105 transition-transform duration-500"
								referrerpolicy="no-referrer"
							/>
						</div>
						<div class="p-8">
							<h3 class="font-display font-black text-2xl mb-4">{study.title}</h3>
							
						</div>
					</div>
				))}
			
			</div>
			<div class="lg:invisible right-3 -bottom-12 absolute"><a href={withBase('/services/meta-ads#case-studies')} class=" neo-brutalism-button bg-white reveal">
					查看更多案例
				</a></div>
			
		</div>
	</section>

	<!-- Testimonials -->

<section
  id="testimonials"
  class="py-16 md:py-28 bg-white px-6 border-y-4 border-black bg-[radial-gradient(#D8D3C9_1px,transparent_1px)] [background-size:20px_20px]"
>
  <div class="max-w-[1200px] mx-auto reveal">
    
    <div class="text-center max-w-[760px] mx-auto mb-16">
      <div class="inline-block bg-[#00f5d4] border-2 border-black px-4 py-1.5 rounded-full font-bold text-lg mb-6 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] text-charcoal transform -rotate-2">
        讓顧客說話
      </div>
      <h2 class="font-display font-black text-[28px] md:text-[36px] text-charcoal mb-6 leading-[1.3]">
       客戶最真實的 WhatsApp 回饋<br />
        <span class="text-xl md:text-2xl text-brand-charcoal font-medium mt-2 block"></span>
      </h2>

      <div class="bg-white border-l-4 border-[#ff006e] p-5 text-left shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] rounded-r-lg inline-block border-2 border-black">
        <p class="text-brand-charcoal text-base leading-[1.6]">
          <strong>【客戶真實評價】</strong>真正的成效不需要過度包裝。這裡展示了 2xWin
          各行各業客戶給我們的真實感受。從消除初期的疑慮，到看見實際業績增長，透明溝通是我們建立長期信任的基石。
        </p>
      </div>
    </div>

    <div class="testimonials-masonry columns-1 sm:columns-2 lg:columns-3 gap-10">
      {sortedImages.map((imgAsset, index) => (
        <div
          class="testimonial-shot-card break-inside-avoid bg-white border-2 border-black rounded-2xl p-3 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-1 transition-all group mb-10 cursor-pointer"
          role="button"
          tabindex="0"
          aria-label={`Open testimonial screenshot ${index + 1}`}
        >
          <div class="testimonial-shot-frame w-full min-h-[220px] bg-[#f1f1f1] rounded-xl border border-black/20 flex items-center justify-center relative overflow-hidden">
            <span class="absolute text-brand-charcoal/30 font-bold text-sm flex flex-col items-center gap-2 group-hover:opacity-0 transition-opacity">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              預留截圖位置
            </span>
            
            <Image
              src={imgAsset}
              alt={`Client review screenshot ${index + 1}`}
              class="testimonial-shot-image w-full h-auto relative z-10 opacity-0 transition-opacity duration-300"
              onload="this.classList.remove('opacity-0')"
              loading={index < 3 ? "eager" : "lazy"} 
              quality="high"
            />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<div
  id="testimonial-lightbox"
  class="testimonial-lightbox fixed inset-0 z-50 bg-black/80 hidden items-center justify-center p-4 opacity-0 transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <div class="testimonial-lightbox__frame relative max-w-4xl w-full max-h-[90vh] flex items-center justify-center">
    <button
      id="testimonial-lightbox-close"
      type="button"
      class="testimonial-lightbox__close absolute -top-12 right-0 text-white hover:text-[#ff006e] transition-colors"
      aria-label="Close screenshot viewer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
    <img
      id="testimonial-lightbox-image"
      src=""
      alt="Full size client review screenshot"
      class="testimonial-lightbox__image max-w-full max-h-[90vh] object-contain rounded-lg border-4 border-white"
    />
  </div>
</div>

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const lightbox = document.getElementById('testimonial-lightbox');
			const lightboxImg = document.getElementById('testimonial-lightbox-image') as HTMLImageElement;
			const closeBtn = document.getElementById('testimonial-lightbox-close');
			const cards = document.querySelectorAll('.testimonial-shot-card');

			if (!lightbox || !lightboxImg || !closeBtn) return;

			const openLightbox = (src: string) => {
				lightboxImg.src = src;
				lightbox.classList.remove('hidden');
				lightbox.classList.add('flex');
				// Small delay to allow display:block to apply before changing opacity
				setTimeout(() => {
					lightbox.classList.remove('opacity-0');
				}, 10);
				document.body.style.overflow = 'hidden';
			};

			const closeLightbox = () => {
				lightbox.classList.add('opacity-0');
				setTimeout(() => {
					lightbox.classList.add('hidden');
					lightbox.classList.remove('flex');
					lightboxImg.src = '';
				}, 300);
				document.body.style.overflow = '';
			};

			cards.forEach(card => {
				card.addEventListener('click', () => {
					const img = card.querySelector('img');
					if (img && img.src && img.style.display !== 'none') {
						openLightbox(img.src);
					}
				});
				
				// Accessibility: open on enter key
				card.addEventListener('keydown', (e) => {
					const keyboardEvent = e as KeyboardEvent;
					if (keyboardEvent.key === 'Enter' || keyboardEvent.key === ' ') {
						e.preventDefault();
						const img = card.querySelector('img');
						if (img && img.src && img.style.display !== 'none') {
							openLightbox(img.src);
						}
					}
				});
			});

			closeBtn.addEventListener('click', closeLightbox);

			// Close on background click
			lightbox.addEventListener('click', (e) => {
				if (e.target === lightbox || (e.target as HTMLElement).classList.contains('testimonial-lightbox__frame')) {
					closeLightbox();
				}
			});

			// Close on escape key
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) {
					closeLightbox();
				}
			});
		});
	</script>

	<!-- Final CTA -->
	<section class="py-24 bg-hot-pink text-white border-y-4 border-black">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h2 class="font-display font-black text-4xl md:text-6xl mb-8 reveal">
				唔想再靠估，<br class="md:hidden" />Send 你個 Website / Page 過嚟
			</h2>
			<p class="text-xl md:text-2xl mb-12 opacity-90 reveal">
				我哋會幫你做一個免費嘅「身體檢查」，話你知你嘅廣告同網站仲有咩進步空間。
			</p>
			<div class="flex justify-center reveal">
				<a href="https://api.whatsapp.com/send/?phone=85252232817&text=%E6%83%B3%E6%9F%A5%E8%A9%A2%E3%80%8C%E7%B7%9A%E4%B8%8A%E5%BB%A3%E5%91%8A%E3%80%8D%E6%9C%8D%E5%8B%99+%28%E6%9F%A5%E8%A9%A2%E7%B7%A8%E8%99%9F%3A+%23225361%29&type=phone_number&app_absent=0" target="_blank" class="neo-brutalism-button bg-white text-charcoal text-2xl py-6 px-12 flex items-center space-x-4">
					<Image src={whatsappImg} alt="WhatsApp logo" class="w-15 h-auto object-contain" />
					<span>免費獲取 Meta 廣告診斷</span>
				</a>
			</div>
		</div>
	</section>
</Layout>
