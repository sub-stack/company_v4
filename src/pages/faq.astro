---
import Layout from '../layouts/Layout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import AEOBlock from '../components/AEOBlock.astro';
import { Image } from 'astro:assets';
import whatsapp from '../assets/img/whatsapp.png';
import { faqPageSchema, jsonLd } from '../utils/seo';
import { withBase } from '../utils/withBase';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const faqs = [
	{
		question: "點解我之前搵 Agency 落廣告無效果？",
		answer: "廣告無效果，通常唔係單一原因。常見有幾種情況：Agency 只係幫你開廣告，冇認真睇過產品競爭力，亦冇理網站或專頁接唔接得住；數據唔透明，你睇唔到真實花費同設定；受眾定得太廣或太窄，又冇做好對比測試，預算就散咗。再加埋帳戶唔喺你手、又用「包單」呢類保證拖住你加預算，問題會更難睇清楚。未再加錢之前，更實際係先搞清楚產品、頁面同追蹤係咪已經準備好。你可以把網站或 Page WhatsApp 過嚟，我哋可以先做免費診斷，直接講樽頸喺邊；呢個診斷唔等於保證之後一定有單。"
	},

	{
		question: "廣告帳戶係邊個嘅？我可唔可以自己睇數據？",
		answer: "兩種方法我哋都接受。可以用你自己嘅廣告帳戶，亦可以用我哋公司帳戶代你投放，兩種收費唔一樣。如果用你嘅帳戶，我哋會入你帳戶操作，而唔係叫你將成個戶口交到我哋名下、淨係等報告；廣告帳戶、專頁同付款方式可以放喺你公司嘅 Business Manager，你自己有管理員權限，隨時可以打開廣告管理員睇花費、受眾、素材同設定。像素、自訂受眾同歷史廣告都應該跟住你盤生意；合作停咗，呢啲資料留喺你度，你亦可以收返我哋嘅操作權限。如果用我哋公司帳戶代投，就按呢個合作方式處理，收費會唔同。想知邊種啱你、收費點計，可以直接 WhatsApp 問清楚。無論用邊種帳戶，都唔等於保證會有單，亦唔保證回報。"
	},

	{
		question: "係咪一定要簽長約？隨時停得唔得？",
		answer: "唔需要。我哋採用「不綁約、月月清」嘅按月收費，唔會用一年死約鎖住你。你覺得做得好先繼續，覺得唔好就可以停，唔需要負擔違約金。停約之後，廣告帳戶、像素、受眾同歷史資料都應該留喺你度。呢個係合作方式，本身唔等於保證業績。"
	},

	{
		question: "你哋會唔會保證包單，或者保證 ROAS？",
		answer: "唔會。我哋唔保證包單，亦唔保證 ROAS（即係廣告花費相對返嚟嘅營業額或成果）。如果有人用「保證包單」或者「ROAS 一定有幾多」做賣點，反而更可疑，老闆要小心，呢類說法好多時係騙局。你要問清楚點樣定義「包到」，達唔到係退款定係叫你再加預算。產品本身有問題，或者網站、專頁接唔住流量，落多啲廣告都唔會自動變單。服務頁提過，過往案例當中有過 ROAS 提升 200%-400% 呢個範圍，但只係過往案例範圍，唔代表保證你會有同樣結果。"
	},

	{
		question: "點樣收費？係定額服務費，定係跟廣告花費抽成？",
		answer: "收費要分開兩部份：一筆係交俾 Meta 嘅廣告費 (實報實銷, 不抽佣)；另一筆係交俾我哋嘅服務月費 (包括顧問服務、廣告設定、數據分析)。我哋定額服務月費，你廣告落多落少，服務費都係統一，而唔係跟廣告花費抽成，咁就唔會變成「你花費愈高，我收入愈高」。"
	},

	{
		question: "網站或者生意都未搞好，可唔可以先落廣告救命？",
		answer: "呢個階段，我哋通常唔建議一嚟就靠外判廣告救命。廣告只係放大器：產品有競爭力、網站或專頁喺手機上順暢、又清楚想要查詢定銷售，先比較容易做得順。如果生意模式未搞掂，或者頁面同跟進流程接唔住人，加廣告費好多時只係放大一個未準備好嘅門口。合作前會先了解：產品係咪已經有人買過；Website / Page / 跟進準唔準備好；你想短期試水溫，定係準備穩定放大。呢個係判斷適唔適合投放，唔係幫你起網站。歡迎將 Page 或網頁 WhatsApp 過嚟，先做免費「身體檢查」，合適先開始。"
	},

	{
		question: "點樣開始合作？免費診斷包啲咩？",
		answer: "WhatsApp +852 5223 2817，提供你嘅網站或 Page。我哋會先做免費「身體檢查」，了解你盤生意狀況後，給出絕對有良心的初步建議，而唔會盲目地向你 Hard-Sell。如果大家覺得合適，先會深入分析產品同網站轉化流程，並對接廣告帳戶；然後先訂受眾、素材同投放節奏，先至開始落廣告。投放之後會持續按數據做優化，每月提供透明、直白嘅成效報告。診斷係幫手判斷而家適唔適合落，本身唔保證之後一定有單。"
	},

	{
		question: "你哋接唔接 Dropshipping、炒賣、賭網或者煙？",
		answer: "唔接。Dropshipping、炒賣、賭網同煙，我哋都唔做；亦唔接想「空手套白狼」、純粹靠廣告博快錢嘅合作。如果你盤生意唔屬於以上類型，又想先了解適唔適合投放 Meta 廣告，歡迎 WhatsApp，把網站或 Page 過嚟先做免費診斷。"
	},

	{
		question: "合作開始之後，你哋會點樣跟數據同報告？",
		answer: "開始之前會先檢查帳號同專頁設置。開始投放之後，會持續跟成效數據，用唔同素材或設定做對比，將預算集中喺真正有效嘅位置。如果係用你自己嘅帳戶，你可以自己入去睇花費、設定同成效，唔使淨係等我哋話你知。"
	}
];
---

<Layout
	title="常見問題 - 關於 Meta 廣告與合作流程"
	description="整理雙贏營銷客戶最常問嘅幾件事：點解之前落廣告未必有結果、係咪要簽長約、同點樣由 WhatsApp 診斷開始。答案跟網站寫明嘅做法，月月清、不綁約，覺得唔合適可以停。我哋唔保證有單，亦唔保證某個 ROAS。未寫喺呢頁嘅服務，就唔當係而家提供緊。"
>
	<script type="application/ld+json" set:html={jsonLd(faqPageSchema(faqs))} />
	<!-- Hero -->
	<section class="pt-32 pb-20 bg-aqua-mint/10 border-b-4 border-black">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<Breadcrumbs items={[
				{ name: '首頁', path: '/' },
				{ name: '常見問題', path: '/faq' },
			]} />
			<div class="max-w-4xl">
				<h1 class="font-display font-black text-4xl md:text-6xl lg:text-7xl leading-[1.1] mb-8 reveal">
					常見問題：<br />
					<span class="bg-electric-yellow px-2 text-charcoal">講真話，唔遊花園</span>
				</h1>
				<p class="text-xl md:text-2xl text-charcoal/80 mb-12 leading-relaxed reveal">
					我哋知道你對廣告 Agency 有好多疑慮。呢度有我哋最直白嘅回答。
				</p>
			</div>
		</div>
	</section>

	<!-- AEO Section -->
	<section class="py-24">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="mb-16">
				<h2 class="font-display font-black text-3xl md:text-5xl mb-6 reveal">
					你想知嘅，我哋都話你知
				</h2>
				<AEOBlock content="2xWin 的 FAQ 頁面旨在解答中小企對 Meta 廣告投放及合作模式的常見疑慮。我們強調透明度、不綁約模式以及商業邏輯先行的策略。通過詳細解答預算去向、數據透明度及合作流程等問題，我們希望在合作前就建立起誠實與信任的基礎。" />
			</div>

			<FAQAccordion items={faqs} />

			<div class="mt-16">
				<h2 class="font-display font-black text-2xl md:text-3xl mb-6">相關文章</h2>
				<ul class="space-y-3 text-lg">
					<li>
						<a href={withBase('/insights/blog/agency-black-box-tactics')} class="font-bold text-hot-pink underline hover:text-charcoal">Agency 黑箱常見手法</a>
					</li>
					<li>
						<a href={withBase('/insights/blog/how-to-choose-meta-ads-agency-hk')} class="font-bold text-hot-pink underline hover:text-charcoal">香港中小企點揀 Meta 廣告代理？</a>
					</li>
					<li>
						<a href={withBase('/insights/blog/meta-ads-not-converting-5-checks')} class="font-bold text-hot-pink underline hover:text-charcoal">Meta 廣告落唔到單？先查呢 5 樣</a>
					</li>
				</ul>
			</div>
		</div>
	</section>

	<!-- Final CTA -->
	<section class="py-24 bg-hot-pink text-white border-y-4 border-black">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h2 class="font-display font-black text-4xl md:text-6xl mb-8 reveal">
				仲有其他疑問？
			</h2>
			<p class="text-xl md:text-2xl mb-12 opacity-90 reveal">
				直接 WhatsApp 我哋，我哋會直接回答你。
			</p>
			<div class="flex justify-center reveal">
				<a href="https://api.whatsapp.com/send/?phone=85252232817&text=%E6%83%B3%E6%9F%A5%E8%A9%A2%E3%80%8C%E7%B7%9A%E4%B8%8A%E5%BB%A3%E5%91%8A%E3%80%8D%E6%9C%8D%E5%8B%99&type=phone_number&app_absent=0" target="_blank" class="neo-brutalism-button bg-white text-charcoal text-2xl py-6 px-12 flex items-center space-x-4">
					<Image src={whatsapp} alt="WhatsApp" class="w-8 h-8" />
					<span>立即 WhatsApp 查詢</span>
				</a>
			</div>
		</div>
	</section>
</Layout>
