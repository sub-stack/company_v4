---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import whatsapp from '../../assets/img/whatsapp.png';
import { withBase } from '../../utils/withBase';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const coverFor = (slug: string) => withBase(`/blog/${slug}.webp`);

---

<Layout
	title="Blog - 最實用嘅獲客知識"
	description="我哋想同你分享最實用嘅 Insights 同 Best Practices，教你點樣善用科技去維持你嘅獲客流程。由淺入深嘅 Lead Gen 知識，保證即學即用。"
>
	<!-- Hero -->
	<section class="pt-32 pb-24 bg-charcoal text-white border-b-4 border-black">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<Breadcrumbs
				tone="inverse"
				items={[
					{ name: '首頁', path: '/' },
					{ name: 'Blog', path: '/insights/blog' },
				]}
			/>
			<div class="max-w-4xl">
				<h1 class="font-display font-black text-4xl md:text-5xl lg:text-6xl leading-[1.2] mb-8 reveal">
					最實用嘅獲客知識，<br />
					保證即學即用。
				</h1>
				<p class="text-lg md:text-xl text-white/90 leading-relaxed reveal">
					我哋想同你分享最<strong class="text-white">實用嘅 Insights</strong> 同 <strong class="text-white">Best Practices</strong>，教你點樣善用科技去維持你嘅<strong class="text-white">獲客流程</strong>。由淺入深嘅 Lead Gen 知識，<strong class="text-white">保證即學即用</strong>。
				</p>
			</div>
		</div>
	</section>

	<!-- Banner -->
	<section class="bg-aqua-mint border-b-4 border-black relative z-20">
		<div class="py-12 text-center px-4">
			<h2 class="font-display font-black text-3xl md:text-4xl text-charcoal reveal">
				睇吓我哋有咩實戰心得分享。
			</h2>
		</div>
		<!-- Triangle pointing down -->
		<div class="absolute left-1/2 -bottom-[45px] -translate-x-1/2 w-16 h-16 bg-aqua-mint border-b-4 border-r-4 border-black transform rotate-45 z-10"></div>
	</section>

	<!-- Blog Posts Grid -->
	<section class="py-24 bg-white relative z-10">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
			<div class="grid grid-cols-1 md:grid-cols-3 gap-12">
				<a href={withBase('/insights/blog/why-own-your-meta-ads-account')} class="group block reveal">
					<p class="font-mono text-charcoal/80 mb-4">2026年11月9日</p>
					<div class="neo-brutalism-card overflow-hidden mb-6 p-0">
						<div class="aspect-[4/3] bg-light-gray relative">
							<img src={coverFor('why-own-your-meta-ads-account')} alt="Meta 廣告帳戶點解要用自己嘅？" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
						</div>
					</div>
					<h3 class="font-display font-bold text-xl text-charcoal group-hover:text-hot-pink transition-colors leading-snug">
						Meta 廣告帳戶點解要用自己嘅？
					</h3>
				</a>

				<a href={withBase('/insights/blog/prepare-site-before-meta-ads')} class="group block reveal" style="transition-delay: 100ms;">
					<p class="font-mono text-charcoal/80 mb-4">2026年11月9日</p>
					<div class="neo-brutalism-card overflow-hidden mb-6 p-0">
						<div class="aspect-[4/3] bg-light-gray relative">
							<img src={coverFor('prepare-site-before-meta-ads')} alt="接 Meta 流量前，網站／落地頁要準備咩？" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
						</div>
					</div>
					<h3 class="font-display font-bold text-xl text-charcoal group-hover:text-hot-pink transition-colors leading-snug">
						接 Meta 流量前，網站／落地頁要準備咩？
					</h3>
				</a>

				<a href={withBase('/insights/blog/hk-sme-meta-ads-budget-start')} class="group block reveal" style="transition-delay: 200ms;">
					<p class="font-mono text-charcoal/80 mb-4">2026年11月9日</p>
					<div class="neo-brutalism-card overflow-hidden mb-6 p-0">
						<div class="aspect-[4/3] bg-light-gray relative">
							<img src={coverFor('hk-sme-meta-ads-budget-start')} alt="中小企 Meta 廣告預算點起步？" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
						</div>
					</div>
					<h3 class="font-display font-bold text-xl text-charcoal group-hover:text-hot-pink transition-colors leading-snug">
						中小企 Meta 廣告預算點起步？
					</h3>
				</a>

				<a href={withBase('/insights/blog/how-to-choose-meta-ads-agency-hk')} class="group block reveal">
					<p class="font-mono text-charcoal/80 mb-4">2026年11月9日</p>
					<div class="neo-brutalism-card overflow-hidden mb-6 p-0">
						<div class="aspect-[4/3] bg-light-gray relative">
							<img src={coverFor('how-to-choose-meta-ads-agency-hk')} alt="香港中小企點揀 Meta 廣告代理？" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
						</div>
					</div>
					<h3 class="font-display font-bold text-xl text-charcoal group-hover:text-hot-pink transition-colors leading-snug">
						香港中小企點揀 Meta 廣告代理？
					</h3>
				</a>

				<a href={withBase('/insights/blog/meta-ads-not-converting-5-checks')} class="group block reveal" style="transition-delay: 100ms;">
					<p class="font-mono text-charcoal/80 mb-4">2026年11月9日</p>
					<div class="neo-brutalism-card overflow-hidden mb-6 p-0">
						<div class="aspect-[4/3] bg-light-gray relative">
							<img src={coverFor('meta-ads-not-converting-5-checks')} alt="Meta 廣告落唔到單？先查呢 5 樣" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
						</div>
					</div>
					<h3 class="font-display font-bold text-xl text-charcoal group-hover:text-hot-pink transition-colors leading-snug">
						Meta 廣告落唔到單？先查呢 5 樣
					</h3>
				</a>

				<a href={withBase('/insights/blog/agency-black-box-tactics')} class="group block reveal" style="transition-delay: 200ms;">
					<p class="font-mono text-charcoal/80 mb-4">2026年11月9日</p>
					<div class="neo-brutalism-card overflow-hidden mb-6 p-0">
						<div class="aspect-[4/3] bg-light-gray relative">
							<img src={coverFor('agency-black-box-tactics')} alt="Agency 黑箱常見手法" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
						</div>
					</div>
					<h3 class="font-display font-bold text-xl text-charcoal group-hover:text-hot-pink transition-colors leading-snug">
						Agency 黑箱常見手法
					</h3>
				</a>

				<!-- Post 1 -->
				<a href={withBase('/insights/blog/google-ads-pmax-2026')} class="group block reveal">
					<p class="font-mono text-charcoal/80 mb-4">2026年3月23日</p>
					<div class="neo-brutalism-card overflow-hidden mb-6 p-0">
						<div class="aspect-[4/3] bg-light-gray relative">
							<img src={coverFor('google-ads-pmax-2026')} alt="4 Critical Google Ads Performance Max Updates in 2026" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
						</div>
					</div>
					<h3 class="font-display font-bold text-xl text-charcoal group-hover:text-hot-pink transition-colors leading-snug">
						2026 年 Google Ads PMax 4 大關鍵更新：香港廣告主必讀
					</h3>
				</a>

				<!-- Post 2 -->
				<a href={withBase('/insights/blog/lead-gen-engine-2026')} class="group block reveal" style="transition-delay: 100ms;">
					<p class="font-mono text-charcoal/80 mb-4">2026年2月27日</p>
					<div class="neo-brutalism-card overflow-hidden mb-6 p-0">
						<div class="aspect-[4/3] bg-light-gray relative">
							<img src={coverFor('lead-gen-engine-2026')} alt="The 2026 Lead Gen Engine" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
						</div>
					</div>
					<h3 class="font-display font-bold text-xl text-charcoal group-hover:text-hot-pink transition-colors leading-snug">
						2026 獲客引擎：點樣同步 SEO、Google、Meta 同 YouTube 廣告將 ROI 推到極致
					</h3>
				</a>

				<!-- Post 3 -->
				<a href={withBase('/insights/blog/ai-overviews-seo-2026')} class="group block reveal" style="transition-delay: 200ms;">
					<p class="font-mono text-charcoal/80 mb-4">2026年1月26日</p>
					<div class="neo-brutalism-card overflow-hidden mb-6 p-0">
						<div class="aspect-[4/3] bg-light-gray relative">
							<img src={coverFor('ai-overviews-seo-2026')} alt="The Evolution of Search" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
						</div>
					</div>
					<h3 class="font-display font-bold text-xl text-charcoal group-hover:text-hot-pink transition-colors leading-snug">
						搜尋引擎大進化：點樣將 AI Overviews 融入你嘅 2026 SEO 策略
					</h3>
				</a>
			</div>
		</div>
	</section>

	<!-- Final CTA -->
	<section class="py-24 bg-charcoal text-white border-y-4 border-black">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h2 class="font-display font-black text-4xl md:text-6xl mb-8 reveal">
				準備好開始穩陣放大生意？
			</h2>
			<div class="flex justify-center reveal">
				<a href="https://api.whatsapp.com/send/?phone=85252232817&text=%E6%83%B3%E6%9F%A5%E8%A9%A2%E3%80%8C%E7%B7%9A%E4%B8%8A%E5%BB%A3%E5%91%8A%E3%80%8D%E6%9C%8D%E5%8B%99&type=phone_number&app_absent=0" target="_blank" class="neo-brutalism-button bg-aqua-mint text-charcoal text-2xl py-6 px-12 flex items-center space-x-4">
					<Image src={whatsapp} alt="WhatsApp" class="w-8 h-8" />
					<span>免費獲取 Meta 廣告診斷</span>
				</a>
			</div>
		</div>
	</section>
</Layout>
